# Raspberry Pi 3B+ — Team Artemis robot
# Copy this file to `.env.robot` and fill in the real values. `.env.robot` is
# gitignored so credentials never land in the repo.

# Local (ET9 hotspot only) — the hotspot DHCP moves this around (.2, .4, ...);
# if unreachable, ping-sweep 172.20.10.2-14 and look for MAC b8:27:eb:*
PI_HOST_LOCAL=172.20.10.x
PI_USER=pi
PI_PASSWORD=changeme

# Tailscale (reachable from anywhere)
PI_HOST_TAILSCALE=100.x.x.x
PI_HOST_TAILSCALE_IPV6=fd7a:115c:a1e0::xxxx:xxxx
PI_HOSTNAME=raspberrypi

# Camera MJPEG stream (run camstream.py on the Pi first)
CAMERA_STREAM_LOCAL=http://172.20.10.x:8080/
CAMERA_STREAM_TAILSCALE=http://100.x.x.x:8080/
CAMERA_STREAM_PATH=/home/pi/camstream.py
