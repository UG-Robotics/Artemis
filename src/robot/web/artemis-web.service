[Unit]
Description=Artemis robot web control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# Point WorkingDirectory at the repo's src/ so `robot` and `core` import cleanly.
WorkingDirectory=/home/pi/artemis/src
ExecStart=/usr/bin/python3 -m robot.web.app
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
